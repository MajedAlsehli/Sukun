enum NotificationType {
  PUSH
  EMAIL
  SMS
}

// 11_State_Machines.md #NOTIFICATION
enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
}

model Notification {
  id     String             @id @default(uuid())
  userId String             @map("user_id")
  title  String
  body   String
  type   NotificationType   @default(PUSH)
  status NotificationStatus @default(QUEUED)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Sakani.sa Market Data (external reference/comparison data pulled from the
// Sakani.sa public API via Parse.bot - NOT part of the ERD/16 docs. Kept
// separate from Project/Building/Unit on purpose: those model YOUR OWN
// companies' inventory with mandatory FKs to a verified Company, while this
// is third-party market data with no company/building/floor concept of its
// own. Keyed by Sakani's own numeric project/unit IDs (not a synthetic UUID)
// so re-imports upsert cleanly instead of duplicating rows.
// ---------------------------------------------------------------------------

model SakaniProject {
  id                  Int      @id // numeric portion of Sakani's project_id, e.g. "project_1458" -> 1458
  externalId          String   @unique @map("external_id") // original string as returned by get_popular_projects, e.g. "project_1458"
  projectCode         String?  @map("project_code")
  name                String   @map("project_name")
  projectType         String?  @map("project_type")
  developerName       String?  @map("developer_name") // only present via get_popular_units' nested project object
  city                String?
  cityId              Int?     @map("city_id")
  region              String?
  regionId            Int?     @map("region_id")
  lat                 Float?
  lon                 Float?
  minPrice            Float?   @map("min_price")
  maxPrice            Float?   @map("max_price")
  marketplacePrice    Float?   @map("marketplace_price")
  availableUnitsCount Int?     @map("available_units_count")
  unitTypes           String[] @map("unit_types")
  raw                 Json // full raw API payload, for anything not modeled above
  fetchedAt           DateTime @default(now()) @map("fetched_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  units SakaniUnit[]

  @@map("sakani_projects")
}

model SakaniUnit {
  id              Int      @id // Sakani's own unit_id
  unitCode        String?  @map("unit_code")
  unitType        String?  @map("unit_type")
  unitSize        Float?   @map("unit_size")
  livingArea      Float?   @map("living_area") // API returns this as a numeric string; parsed to Float on import
  price           Float?
  mohPrice        Float?   @map("moh_price")
  bedroomCount    Int?     @map("bedroom_count")
  bathroomCount   Int?     @map("bathroom_count")
  floor           Int?
  apartmentNumber String?  @map("apartment_number")
  blockNumber     String?  @map("block_number")
  buildingNumber  String?  @map("building_number")
  status          String?
  targetSegments  String[] @map("target_segments")
  projectId       Int?     @map("project_id")
  lat             Float?
  lon             Float?
  raw             Json
  fetchedAt       DateTime @default(now()) @map("fetched_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project SakaniProject? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("sakani_units")
}

model SakaniPriceRange {
  id             String   @id @default(uuid())
  cityId         Int?     @map("city_id")
  regionId       Int?     @map("region_id")
  projectType    String?  @map("project_type")
  maxPrice       Float?   @map("max_price")
  maxRentalPrice Float?   @map("max_rental_price")
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  @@map("sakani_price_ranges")
}

model SakaniSyncLog {
  id          String   @id @default(uuid())
  version     String
  endpoint    String
  recordCount Int      @map("record_count")
  startedAt   DateTime @map("started_at")
  finishedAt  DateTime @map("finished_at")

  @@map("sakani_sync_logs")
}

// ---------------------------------------------------------------------------
// Audit Logs (AUD-005/AUD-010: immutable, append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  ipAddress String?  @map("ip_address")
  metadata  Json?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Task 8 (docs/integration/decisions.md Part I): the canonical POST-OWNERSHIP
// report domain — H8 (create) → H9 (track/approve/reopen) → C1/C2 (repair) →
// C3 (history) → PM2 (monitor) → RE3/RE4/RE5 (references).
//
// This is B1's implemented resolution (decisions.md I0). It is deliberately a
// *separate* domain from the pre-ownership `InspectionReport` + `Repair`
// pipeline above, which is left completely untouched: no relation here points
// at either of them, and `Repair` was NOT made polymorphic. Legacy
// `WarrantyReport` rows are mirrored (never moved, never modified, never
// deleted) by an additive, idempotent, opt-in backfill via
// `Report.legacyWarrantyReportId` (decisions.md I3).
// ---------------------------------------------------------------------------

// H8's own nine category tiles (`catList` in `Sakn Report Journey.dc.html`:
// سباكة/كهرباء/تشققات/دهانات/أبواب/نوافذ/أرضيات/أسقف/أخرى). Not the same
// taxonomy as H10's six warranty categories — see decisions.md I4a for the
// explicit, evidence-only mapping between them.
enum ReportCategory {
  PLUMBING
  ELECTRICAL
  CRACKS
  PAINT
  DOORS
  WINDOWS
  FLOORING
  CEILINGS
  OTHER
}

// H8/H9/C1/C2/C3/PM2 all render exactly three levels (منخفضة/متوسطة/عالية).
// Deliberately NOT reusing `InspectionPriority`, which carries a fourth
// (CRITICAL) that no post-ownership reference screen can display.
enum ReportPriority {
  LOW
  MEDIUM
  HIGH
}

// decisions.md I6: whether the stored priority came from a validated AI
// analysis or from the documented manual-entry default (MEDIUM). Surfaced in
// the DTO so PM2 never presents a default as an AI verdict.
enum ReportPrioritySource {
  AI
  MANUAL_DEFAULT
}

// decisions.md I2 — the one canonical status machine. Five states, no more:
// ROUTING_PENDING → ROUTED → IN_PROGRESS → AWAITING_OWNER_APPROVAL → CLOSED,
// plus AWAITING_OWNER_APPROVAL → IN_PROGRESS on a homeowner reopen. There is
// no arbitrary status PATCH anywhere; each transition has its own endpoint.
enum ReportStatus {
  ROUTING_PENDING
  ROUTED
  IN_PROGRESS
  AWAITING_OWNER_APPROVAL
  CLOSED
}

// decisions.md I4: snapshotted once at creation and never recomputed.
// NOT_EVALUATED_LEGACY exists solely for backfilled rows (I3) — the rules in
// force when a legacy WarrantyReport was filed are unknowable, so no verdict
// is retroactively invented for one.
enum ReportWarrantyVerdict {
  COVERED
  NOT_COVERED
  NOT_CONFIGURED
  NO_WARRANTY
  NOT_EVALUATED_LEGACY
}

enum ReportRoutingState {
  PENDING
  ROUTED
}

enum ReportMediaStage {
  HOMEOWNER
  BEFORE
  AFTER
}

// decisions.md I2: only IN_PROGRESS counts as "active" for the
// single-active-repair rule, which is enforced by the partial unique index
// `report_repairs_active_technician_unique`. A homeowner reopen moves the row
// to REOPENED (not IN_PROGRESS) so the homeowner's action can never be
// blocked by, or silently violate, the technician's lock.
enum ReportRepairStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REOPENED
}

enum ReportActorType {
  HOMEOWNER
  TECHNICIAN
  SYSTEM
  AI
}

// decisions.md I5: append-only. Every label the H9/PM2/C3 reference timelines
// render maps onto one of these; nothing is free text.
enum ReportTimelineEventType {
  REPORT_CREATED
  AI_ANALYSIS_RECORDED
  AI_ANALYSIS_UNAVAILABLE
  WARRANTY_EVALUATED
  ROUTING_PENDING_RECORDED
  TECHNICIAN_ASSIGNED
  ROUTING_RETRIED
  REPAIR_STARTED
  REPAIR_MEDIA_ADDED
  REPAIR_SUBMITTED
  HOMEOWNER_APPROVED
  HOMEOWNER_REOPENED
  REPORT_CLOSED
  REVIEW_SUBMITTED
  LEGACY_IMPORTED
}

enum ReportOrigin {
  HOMEOWNER
  LEGACY_WARRANTY_REPORT
}

model Report {
  id String @id @default(uuid())

  // decisions.md I1: rendered as "#1042" by every reference screen. Uniqueness
  // is the Postgres sequence + this unique index, not application code; the
  // migration restarts the sequence at 1001 purely so numbers are four digits
  // like the reference mocks.
  reportNumber Int @unique @default(autoincrement()) @map("report_number")

  homeownerId String @map("homeowner_id")

  // Immutable historical references, captured at creation (invariant 9): a
  // later unit/homeowner/technician/project transfer affects FUTURE routing
  // only and never repoints an existing report.
  ownershipId String @map("ownership_id")
  unitId      String @map("unit_id")
  buildingId  String @map("building_id")
  projectId   String @map("project_id")

  // The category the report is actually filed under — the user-confirmed one
  // (H8's "نعم، صحيح" or its correction), never the raw AI suggestion.
  category                ReportCategory
  categoryConfirmedByUser Boolean        @default(true) @map("category_confirmed_by_user")
  problemText             String         @map("problem_text")
  homeownerNote           String?        @map("homeowner_note")

  // decisions.md I6: advisory record only. All null on the manual-entry path —
  // never back-filled with a plausible-looking confidence.
  analysisId          String?         @unique @map("analysis_id")
  aiSuggestedCategory ReportCategory? @map("ai_suggested_category")
  aiConfidence        Int?            @map("ai_confidence")
  aiProblemText       String?         @map("ai_problem_text")
  aiExplanation       String?         @map("ai_explanation")
  aiProvider          String?         @map("ai_provider")
  aiModel             String?         @map("ai_model")

  priority       ReportPriority
  prioritySource ReportPrioritySource @default(AI) @map("priority_source")

  // decisions.md I4: written once inside the creation transaction, never
  // updated by any later code path (asserted by test).
  warrantyVerdict      ReportWarrantyVerdict @map("warranty_verdict")
  warrantyReasonCode   String                @map("warranty_reason_code")
  warrantyCategoryKey  String?               @map("warranty_category_key")
  warrantyRulesVersion String                @map("warranty_rules_version")
  warrantyEvaluatedAt  DateTime              @map("warranty_evaluated_at")
  warrantyPeriodStart  DateTime?             @map("warranty_period_start")
  warrantyPeriodEnd    DateTime?             @map("warranty_period_end")

  status ReportStatus @default(ROUTING_PENDING)

  // decisions.md I8/I9
  routingState         ReportRoutingState @default(PENDING) @map("routing_state")
  routingReasonCode    String?            @map("routing_reason_code")
  routingAttemptCount  Int                @default(0) @map("routing_attempt_count")
  lastRoutingAttemptAt DateTime?          @map("last_routing_attempt_at")

  assignedTechnicianId String?   @map("assigned_technician_id")
  // Written once at first assignment and never updated — the historical
  // record of who the system originally routed this report to.
  originalTechnicianId String?   @map("original_technician_id")
  assignedAt           DateTime? @map("assigned_at")

  // decisions.md I10: null whenever the priority has no configured SLA target
  // (MEDIUM/LOW today) — an honest "not configured", never a guessed deadline.
  slaStartDueAt   DateTime? @map("sla_start_due_at")
  slaRulesVersion String    @map("sla_rules_version")

  reopenCount Int @default(0) @map("reopen_count")

  origin                 ReportOrigin @default(HOMEOWNER)
  // decisions.md I3: idempotency key for the legacy backfill. Null for every
  // report a homeowner actually filed through H8.
  legacyWarrantyReportId String?      @unique @map("legacy_warranty_report_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")

  homeowner            User            @relation(fields: [homeownerId], references: [id])
  ownership            Ownership       @relation(fields: [ownershipId], references: [id])
  unit                 Unit            @relation(fields: [unitId], references: [id])
  building             Building        @relation(fields: [buildingId], references: [id])
  project              Project         @relation(fields: [projectId], references: [id])
  assignedTechnician   Technician?     @relation("ReportAssignedTechnician", fields: [assignedTechnicianId], references: [id])
  originalTechnician   Technician?     @relation("ReportOriginalTechnician", fields: [originalTechnicianId], references: [id])
  analysis             ReportAnalysis? @relation(fields: [analysisId], references: [id])
  legacyWarrantyReport WarrantyReport? @relation(fields: [legacyWarrantyReportId], references: [id])

  media    ReportMedia[]
  repair   ReportRepair?
  timeline ReportTimelineEvent[]
  review   ReportReview?

  @@index([homeownerId, createdAt])
  @@index([projectId, status])
  @@index([unitId])
  @@index([buildingId])
  @@index([assignedTechnicianId, status])
  @@index([status])
  @@index([ownershipId])
  @@map("reports")
}

// DB-007 (images never stored in the database): durable storage key + public
// URL only, never bytes and never base64. decisions.md I11.
model ReportMedia {
  id           String           @id @default(uuid())
  reportId     String           @map("report_id")
  stage        ReportMediaStage
  // Server-derived object key ("reports/{reportId}/{stage}/{uuid}.{ext}") —
  // no client-supplied string ever reaches a storage path.
  storageKey   String           @map("storage_key")
  url          String
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  sortOrder    Int              @default(0) @map("sort_order")
  uploadedById String?          @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  report     Report @relation(fields: [reportId], references: [id])
  uploadedBy User?  @relation(fields: [uploadedById], references: [id])

  @@index([reportId, stage, sortOrder])
  @@map("report_media")
}

// decisions.md I0 (#6): the dedicated post-ownership repair model. Legacy
// `Repair` is untouched and still points only at `InspectionReport`.
model ReportRepair {
  id           String             @id @default(uuid())
  reportId     String             @unique @map("report_id")
  technicianId String             @map("technician_id")
  status       ReportRepairStatus @default(IN_PROGRESS)

  startedAt           DateTime  @map("started_at")
  submittedAt         DateTime? @map("submitted_at")
  homeownerDecisionAt DateTime? @map("homeowner_decision_at")

  technicianNote        String? @map("technician_note")
  homeownerReopenReason String? @map("homeowner_reopen_reason")

  // Wall-clock minutes from first start to homeowner approval — C3's "المدة"
  // column and RE5's average-duration statistic both read this, never a
  // client-supplied number.
  durationMinutes Int? @map("duration_minutes")
  reopenCount     Int  @default(0) @map("reopen_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  report     Report        @relation(fields: [reportId], references: [id])
  technician Technician    @relation(fields: [technicianId], references: [id])
  review     ReportReview?

  @@index([technicianId, status])
  @@map("report_repairs")
}

// decisions.md I5: APPEND-ONLY. The repository exposes create/list and no
// update or delete; no service code path mutates a row. A report and its
// timeline are never deleted (A7).
model ReportTimelineEvent {
  id        String                  @id @default(uuid())
  reportId  String                  @map("report_id")
  type      ReportTimelineEventType
  actorType ReportActorType
  actorId   String?                 @map("actor_id")
  // Small, service-built, structured JSON only — never a raw request body,
  // never a secret, never an image payload (counts and storage keys at most).
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  // `id` is part of the ordering index so two events written inside the same
  // transaction (identical createdAt) still order deterministically.
  @@index([reportId, createdAt, id])
  @@map("report_timeline_events")
}

// decisions.md I13: one review per closed report, enforced at the database
// level by reportId @unique. Deliberately NOT `VisitFeedback` reused — a
// visit rating and a repair rating are different things and must never feed
// each other's averages (G11 holds in both directions).
model ReportReview {
  id             String @id @default(uuid())
  reportId       String @unique @map("report_id")
  reportRepairId String @unique @map("report_repair_id")
  technicianId   String @map("technician_id")
  homeownerId    String @map("homeowner_id")

  rating  Int
  comment String?

  createdAt DateTime @default(now()) @map("created_at")

  report       Report       @relation(fields: [reportId], references: [id])
  reportRepair ReportRepair @relation(fields: [reportRepairId], references: [id])
  technician   Technician   @relation(fields: [technicianId], references: [id])
  homeowner    User         @relation(fields: [homeownerId], references: [id])

  @@index([technicianId, createdAt])
  @@map("report_reviews")
}

// decisions.md I6: the server-side record of one POST /api/reports/analyze
// result. POST /api/reports takes an opaque `analysisId`, never the AI fields
// themselves — that is the mechanism (not just a comment) behind "AI advises,
// it never decides". Rows are per-user, single-use, and carry the exact media
// keys they were computed from.
model ReportAnalysis {
  id     String @id @default(uuid())
  userId String @map("user_id")

  provider String
  model    String

  suggestedCategory ReportCategory @map("suggested_category")
  problemText       String         @map("problem_text")
  priority          ReportPriority
  confidence        Int
  explanation       String

  // Storage keys the analysis was computed from; POST /api/reports refuses an
  // analysis whose keys do not exactly match the media being submitted.
  mediaKeys String[] @map("media_keys")

  // Validated object-detection output when an ObjectDetectionProvider is
  // actually configured. Null in this environment — YOLO is not configured
  // and nothing claims otherwise (decisions.md I7).
  detections Json?

  consumedByReportId String?  @unique @map("consumed_by_report_id")
  createdAt          DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  report Report?

  @@index([userId, createdAt])
  @@map("report_analyses")
}
