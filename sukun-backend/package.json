{
  "name": "sukun-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sukun platform backend — an AI-powered residential experience API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "sakani:sync": "ts-node --transpile-only src/scripts/sync-sakani.ts",
    "task8:backfill-legacy-reports": "ts-node --transpile-only src/scripts/backfill-legacy-warranty-reports.ts",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.ts\"",
    "vercel-build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "demo:seed": "ts-node --transpile-only src/scripts/demo-seed.ts",
    "demo:preflight": "ts-node --transpile-only src/scripts/demo-preflight.ts",
    "demo:reset": "ts-node --transpile-only src/scripts/demo-seed.ts --reset",
    "demo:unlock": "ts-node --transpile-only src/scripts/unlock-demo-accounts.ts",
    "demo:normalize": "ts-node --transpile-only src/scripts/normalize-demo-tenant.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.104.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
