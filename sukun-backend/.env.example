# Server
PORT=4000
NODE_ENV=development

# Exact browser origins allowed to send credentialed requests
FRONTEND_URL=http://localhost:3001
FRONTEND_URLS=

# PostgreSQL / Supabase
DATABASE_URL="postgresql://user:password@localhost:6543/sukun?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://user:password@localhost:5432/sukun?schema=public"

# Authentication — use different random values of at least 32 characters
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_COOKIE_SAMESITE=
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Local development media
STORAGE_ROOT=./storage
REPORT_MEDIA_STORAGE_DRIVER=
PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase Storage — service key is server-only
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PRIVATE_BUCKET=
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=300

# AI providers
OPENAI_API_KEY=
YOLO_DETECTION_SERVICE_URL=
YOLO_INFERENCE_URL=
YOLO_INFERENCE_API_KEY=
YOLO_API_KEY=
YOLO_INFERENCE_CONFIDENCE=
YOLO_INFERENCE_IOU=

# Optional report routing and operational thresholds
REPORT_SLA_AT_RISK_FRACTION=
PM_ALERT_AWAITING_APPROVAL_HOURS=
PM_ALERT_STALLED_HOURS=
ROUTING_RETRY_SECRET=
CRON_SECRET=

# Optional outbound notification providers
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=

# Optional Sakani market-data import
SAKANI_API_BASE_URL=
SAKANI_REGION_ID=
SAKANI_CITY_ID=
SAKANI_PROJECT_TYPE=
SAKANI_LIMIT=
PARSE_API_KEY=
PARSE_API_SNAPSHOT_VERSION=

# Demo tooling — never place a real password in this file
DEMO_TENANT_LABEL=SUKUN-DEMO
DEMO_EMAIL_DOMAIN=sukun-demo.local
DEMO_ASSET_BASE_URL=

# API documentation
SWAGGER_ENABLED=false
SWAGGER_TOKEN=
